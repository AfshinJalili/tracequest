{
  "name": "tracequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm run format:check && npm test && npm run build",
    "format": "prettier --write src tests scripts docs *.json *.ts *.md",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.md",
    "verify:pack": "node scripts/verify-review-pack.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.55.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
